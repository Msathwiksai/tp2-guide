# Copy this file to `.env.local` and fill in your key.
# `.env.local` is gitignored (via the `*.local` rule) - never commit a real key.

# Required. Get one from https://aistudio.google.com/apikey
# Read only by server.mjs. Never expose it as a VITE_* variable: anything
# prefixed VITE_ is inlined into the client bundle and is public.
GEMINI_API_KEY=

# Optional. Port for the API server (defaults to 3001).
# Prefer this over PORT - PORT is commonly set by hosts and preview panes, and
# if it changes, Vite's /api proxy target no longer matches.
# API_PORT=3001

# Optional. Override the origin Vite proxies /api to during development.
# API_ORIGIN=http://localhost:3001

# Optional. Requests per minute per IP against the AI routes (default 8).
# Kept just under the Gemini free tier's ~10 RPM so this limiter fires first
# and users get a clear message instead of an opaque provider error.
# RATE_LIMIT_PER_MIN=8

# Optional. Video generation (Veo), OFF by default because it is BILLABLE and
# has no free tier - a free-tier key returns 429 on every request. Turn it on
# only with billing enabled, or the button will fail for everyone.
# ENABLE_VIDEO=true
# VEO_MODEL=veo-3.1-fast-generate-preview

# Optional. Comma-separated model fallback list for text generation. The server
# walks these in order when one reports "high demand", which free-tier traffic
# hits often.
# GEMINI_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.7-flash
