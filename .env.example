# Copy this file to `.env.local` and fill in your key.
# `.env.local` is gitignored (via the `*.local` rule) - never commit a real key.

# Required. Get one from https://aistudio.google.com/apikey
# Read only by server.mjs. Never expose it as a VITE_* variable: anything
# prefixed VITE_ is inlined into the client bundle and is public.
GEMINI_API_KEY=

# Optional. Port for the API server (defaults to 3001).
# Prefer this over PORT - PORT is commonly set by hosts and preview panes, and
# if it changes, Vite's /api proxy target no longer matches.
# API_PORT=3001

# Optional. Override the origin Vite proxies /api to during development.
# API_ORIGIN=http://localhost:3001

# Optional. Requests per minute per IP against the AI routes (default 8).
# Kept just under the Gemini free tier's ~10 RPM so this limiter fires first
# and users get a clear message instead of an opaque provider error.
# RATE_LIMIT_PER_MIN=8

# Optional. Video generation (Veo), OFF by default because it is BILLABLE and
# has no free tier - a free-tier key returns 429 on every request. Turn it on
# only with billing enabled, or the button will fail for everyone.
# ENABLE_VIDEO=true
# VEO_MODEL=veo-3.1-fast-generate-preview

# Optional. Comma-separated model fallback list for text generation. The server
# walks these in order when one reports "high demand", which free-tier traffic
# hits often.
# GEMINI_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.7-flash

# ---------------------------------------------------------------------------
# Text provider
# ---------------------------------------------------------------------------
# Gemini's free tier is heavily deprioritised - "high demand" 503s are common
# enough to make the app feel broken. Any OpenAI-compatible endpoint can serve
# text instead. Image and video generation always stay on Gemini, because
# OpenAI-compatible chat endpoints do not produce images.
#
# TEXT_PROVIDER=gemini   (default)
# TEXT_PROVIDER=openai   use OPENAI_BASE_URL / OPENAI_API_KEY / OPENAI_MODELS
#
# NVIDIA NIM (free tier is ~40 req/min vs Gemini's ~10). Key from build.nvidia.com:
# TEXT_PROVIDER=openai
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_API_KEY=nvapi-...
# OPENAI_MODELS=nvidia/nemotron-3-super-120b-a12b,openai/gpt-oss-20b
#
# Pick by throughput, not by reputation. A guide is thousands of output tokens,
# so tokens/sec decides whether it arrives before the client's 120s ceiling.
# Measured against this free endpoint:
#   nvidia/nemotron-3-super-120b-a12b  ~110 tok/s  full guide in ~16-22s
#   openai/gpt-oss-20b                  ~26 tok/s  full guide timed out at 150s
#   moonshotai/kimi-k3                queued: a 16-token reply took over 2 min
# Model names go stale - meta/llama-3.3-70b-instruct now returns 410 Gone. Check
# a candidate against GET {OPENAI_BASE_URL}/models before putting it in the list.
#
# OPENAI_MAX_TOKENS=12000  output ceiling. Too low and a guide is truncated into
#   unparseable JSON; the server names that failure rather than dying on a JSON
#   parse offset.
# UPSTREAM_TIMEOUT_MS=45000  how long to wait on one model before falling
#   through to the next. Free endpoints can queue a request for minutes, which
#   is longer than the browser is willing to wait.
# OPENAI_EXTRA_BODY={"chat_template_kwargs":{"thinking":false}}
#   JSON merged into the request body for provider-specific settings. This one
#   turns off Nemotron's reasoning: the scratchpad counts against max_tokens, so
#   leaving it on truncated guides mid-JSON.
#
# OPENAI_JSON_MODE=schema  (default) enforce the response shape via
#   response_format json_schema - the closest equivalent to Gemini responseSchema.
# OPENAI_JSON_MODE=object   fall back to json_object for models that reject
#   json_schema; the shape is then described in the prompt instead.
#
# Groq, OpenRouter, Together and a local Ollama all work the same way - only
# the base URL, key and model names change. Comma-separate OPENAI_MODELS to get
# the same fallback-on-busy behaviour Gemini has.
